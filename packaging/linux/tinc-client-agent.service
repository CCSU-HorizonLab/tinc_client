[Unit]
Description=Tinc Client local VPN agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/lib/tinc-client/vpn-agent
User=root
Group=root
RuntimeDirectory=tinc-client
RuntimeDirectoryMode=0755
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=130
KillMode=control-group
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/tinc-client /run/tinc-client
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_CHOWN CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
