{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tinc Connect", "version": "0.1.0", "identifier": "com.tincclient.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{"label":"main","title":"Tinc Connect","width":1120,"height":900,"minWidth":780,"minHeight":640}], "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'" } },
  "bundle": { "active": true, "useLocalToolsDir": true, "targets": ["nsis","deb"], "shortDescription": "Tinc VPN desktop client", "category": "Utility", "windows": {"nsis":{"installMode":"perMachine","installerHooks":"../../../packaging/windows/installer-hooks.nsh"}} }
